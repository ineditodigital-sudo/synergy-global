{
  "name": "synergy-global-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8787 -t public tools/dev-router.php",
    "prebuild": "node tools/build-seed.mjs",
    "build": "vite build && node tools/postbuild.mjs",
    "serve": "php -S 127.0.0.1:8787 -t dist tools/dev-router.php",
    "lint": "eslint .",
    "optimize-assets": "node tools/optimize-assets.mjs",
    "export:pptx": "node tools/export-pptx.mjs",
    "set-password": "php tools/generate_hash.php",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy_synergy.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.0.12"
  }
}
